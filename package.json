{
  "name": "akira",
  "version": "0.5.9",
  "description": "Akira's Test Bot",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --fix && git add . && git commit -m 'style: lint'",
    "release": "standard-version",
    "build": "tsc",
    "start": "NODE_ENV=production tsc && node -r tsconfig-paths/register dist/index.js",
    "dev": "NODE_ENV=development ts-node -r tsconfig-paths/register src/index.ts"
  },
  "author": "Lynnux",
  "license": "MIT",
  "dependencies": {
    "@tryforge/forge.api": "github:tryforge/Forgeapi#dev",
    "@tryforge/forge.db": "github:tryforge/ForgeDB#dev",
    "@tryforge/forge.topgg": "github:tryforge/ForgeTopGG#dev",
    "@tryforge/forgescript": "github:tryforge/Forgescript#dev",
    "axios": "^1.7.9",
    "deasync": "^0.1.30",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "fs": "0.0.1-security",
    "js-yaml": "^4.1.0",
    "mysql": "^2.18.1",
    "path": "^0.12.7",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/deasync": "^0.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-define-config": "^2.1.0",
    "standard-version": "^9.5.0"
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "section": "Chores"
      },
      {
        "type": "refactor",
        "section": "Code Refactoring"
      },
      {
        "type": "perf",
        "section": "Performance Improvements"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "style",
        "section": "Styles"
      },
      {
        "type": "test",
        "section": "Tests"
      }
    ]
  }
}
